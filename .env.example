# Ozon Seller API
OZON_CLIENT_ID=your_client_id_here
OZON_API_KEY=your_api_key_here
OZON_API_BASE_URL=https://api-seller.ozon.ru

# Ozon Performance API (реклама) — OAuth 2.0
OZON_PERFORMANCE_CLIENT_ID=your_performance_client_id@advertising.performance.ozon.ru
OZON_PERFORMANCE_CLIENT_SECRET=your_performance_secret_here
OZON_PERFORMANCE_API_URL=https://api-performance.ozon.ru

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=ozon_user
DB_PASS=ozon_pass
DB_NAME=ozon_collector

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram уведомления
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

MODE=LOCAL
